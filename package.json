{
    "name": "tap-cap-table",
    "version": "1.0.0",
    "private": true,
    "author": "PALMER.EARTH CORP",
    "license": "BUSL-1.1",
    "description": "Transfer Agent Protocol onchain cap table",
    "type": "module",
    "packageManager": "pnpm@10.18.2",
    "scripts": {
        "prod": "tsx server/server.js --no-poller",
        "prod-poller": "tsx server/entry.ts --finalized-only",
        "dev": "tsx watch server/server.js",
        "eslint": "eslint --cache --cache-location=node_modules/.cache/.eslintcache --fix",
        "lint": "pnpm run eslint .",
        "format": "prettier '**/*' --ignore-unknown --write",
        "typecheck": "concurrently --raw pnpm:typecheck:*",
        "typecheck:app": "tsc --noEmit",
        "deploy-factory": "./scripts/deployFactory.sh",
        "setup": "cd chain && foundryup && forge build --via-ir",
        "test": "cd chain && forge test",
        "docs:dev": "pnpm --filter tap-docs dev",
        "docs:build": "pnpm --filter tap-docs build",
        "docs:start": "pnpm --filter tap-docs start",
        "app:dev": "pnpm --filter tap-app dev",
        "app:build": "pnpm --filter tap-app build",
        "app:start": "pnpm --filter tap-app start",
        "app:test:e2e": "pnpm --filter tap-app test:e2e",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "docker:mongo": "docker compose up -d mongodb",
        "docker:logs": "docker compose logs -f",
        "docker:build": "docker compose up -d --build",
        "bootstrap": "./scripts/bootstrap-plume.sh",
        "poller:fast-forward": "tsx server/scripts/fastForwardPoller.ts",
        "factory:register": "tsx server/scripts/registerFactory.ts",
        "test:units": "pnpm --filter @tap/units test",
        "typecheck:units": "pnpm --filter @tap/units typecheck"
    },
    "dependencies": {
        "@tap/units": "workspace:*",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "busboy": "^1.6.0",
        "dotenv": "^17.2.3",
        "ethers": "^6.11.1",
        "express": "^4.18.2",
        "mongoose": "^9.9.3",
        "p-retry": "^6.2.0",
        "tsx": "^4.7.0",
        "uuid": "^14.0.2",
        "xstate": "^4.38.2",
        "yauzl": "^2.10.0"
    },
    "browserslist": [
        "defaults",
        "not IE 11",
        "maintained node versions"
    ],
    "pnpm": {
        "overrides": {
            "@xmldom/xmldom": "^0.9.10",
            "ajv@<7": "6.14.0",
            "ajv@>=8": "8.20.0",
            "axios": "^1.13.5",
            "body-parser": "1.20.6",
            "brace-expansion@<2": "1.1.18",
            "brace-expansion@>=2 <3": "2.1.4",
            "brace-expansion@>=3": "5.0.9",
            "dompurify": "3.4.12",
            "fast-uri": "^3.1.2",
            "form-data@>=3 <4": "3.0.5",
            "handlebars": "^4.7.9",
            "ip-address": "10.3.1",
            "js-yaml": "^4.3.1",
            "lodash": "^4.17.23",
            "lodash-es": "^4.17.23",
            "mermaid": "^11.16.1",
            "nanoid@<5": "3.3.18",
            "path-to-regexp@<1": "0.1.13",
            "postcss": "^8.5.18",
            "qs": "6.15.2",
            "socket.io-parser": "^4.2.7",
            "tmp": "^0.2.6",
            "undici": "^6.27.0",
            "ws@>=7 <8": "7.5.11",
            "ws@>=8": "8.21.0",
            "yaml": "2.8.3"
        }
    },
    "devDependencies": {
        "@eslint/js": "^9.37.0",
        "@types/node": "^24.6.2",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "globals": "^16.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.3",
        "prettier": "^3.6.2",
        "solhint": "^6.2.1",
        "typescript": "^5.3.3",
        "typescript-eslint": "^8.45.0"
    }
}
