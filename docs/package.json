{
    "name": "tap-docs",
    "version": "1.5.0",
    "private": true,
    "license": "BUSL-1.1",
    "description": "Developer documentation for Transfer Agent Protocol",
    "scripts": {
        "predev": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
        "dev": "next dev -p 3001",
        "prebuild": "node -e \"require('fs').rmSync('public/_pagefind',{recursive:true,force:true})\"",
        "build": "next build",
        "postbuild": "node scripts/build-search.mjs",
        "test:search": "node --test scripts/build-search.test.mjs",
        "start": "next start -p 3001",
        "lint": "eslint ."
    },
    "dependencies": {
        "next": "^16.4.6",
        "nextra": "^4.6.1",
        "nextra-theme-docs": "^4.6.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "eslint": "^9.37.0",
        "eslint-config-next": "^16.4.6",
        "pagefind": "^1.6.0",
        "typescript": "^5.7.0"
    }
}
