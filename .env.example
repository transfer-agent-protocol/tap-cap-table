# Offchain db connection string for mongodb
DATABASE_URL="mongodb://tap:tap@localhost:27017/mongo?authSource=admin&retryWrites=true&w=majority"
DATABASE_REPLSET="0"  # set to "1" if using --replSet option in mongo. this allows transactions

# RPC URL for blockchain connection
# Anvil (local):        http://127.0.0.1:8545
# Plume Mainnet:        https://rpc.plume.org
# Plume Testnet:        https://testnet-rpc.plume.org
RPC_URL=https://rpc.plume.org

# Chain ID for the network you are deploying to
# Anvil (local):        31337
# Plume Mainnet:        98866
# Plume Testnet:        98867
CHAIN_ID=98866

# Server / operator private key (hex) — DEV/DEMO ONLY. Optional for wallet-first /app UI:
# leave UPDATE_ME and the poller stays read-only (expected). Used only for server-signed
# API paths and CLI deploy-factory from this machine. Never put production or factory-owner
# keys here; rotate/replace with real secret management later. Never commit real keys.
# Three keys (owner ≠ ADMIN wallet ≠ this): docs → development/setup#three-wallets-keys
# When the server IS the operator, derive NEXT_PUBLIC_OPERATOR_ADDRESS from this key.
PRIVATE_KEY=UPDATE_ME

# Server port
PORT=8293

# Number of issuers processed concurrently per polling cycle (poller is slated for
# replacement by an indexer; this is the single tuning knob it exposes).
POLLER_MAX_CONCURRENCY=8

# --- Frontend (app/) ---
# Host product UI (`pnpm app:dev`) reads app/.env.local — copy these NEXT_PUBLIC_*
# values there too. Docker app interpolates the same vars from this root .env.
# Wallet UI is first-party (EIP-6963 injected). Install a browser extension (Rabby, MetaMask, etc.).
# No cloud account or project id required.

# CapTableFactory the app mints against.
# Shared demo on Plume (protocol-builder owned; beacon upgrades not yours):
#   0xcd6Df14406b0569ceEABa884A18717774EdeaCA1
# Or your own after `pnpm deploy-factory` (you become factory owner).
# Keep in sync with Mongo `factories` collection.
NEXT_PUBLIC_FACTORY_ADDRESS=0xcd6Df14406b0569ceEABa884A18717774EdeaCA1

# Chain ID the frontend targets (same values as CHAIN_ID above)
NEXT_PUBLIC_CHAIN_ID=98866

# API server URL for the frontend to proxy requests (host-reachable, not docker DNS)
# In development, Next.js rewrites /api/* to this URL
NEXT_PUBLIC_API_URL=http://localhost:8293

# Address (not a key) granted OPERATOR_ROLE on newly created cap tables (createCapTable arg).
# Does not require that private key on the server unless the API will sign as operator.
# Wallet-first ADMIN already counts as operator onchain. Demo default often TAP Admin;
# self-hosted TA usually uses the server wallet address matching PRIVATE_KEY when set.
NEXT_PUBLIC_OPERATOR_ADDRESS=0x366aA809015061C101983900d0c2ebf7d71B96AF
